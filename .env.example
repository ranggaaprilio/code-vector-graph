# Environment variables for codeVectorGraph
# Copy this file to .env and fill in your values

# Optional: active embedding model — 'nomic' or 'jina' (default: nomic)
# EMBEDDING_MODEL_ID=nomic

# HuggingFace Hub token for authenticated requests
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# Anthropic API key — required for the web dashboard AI chat
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: which Anthropic model to use for chat (default: claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: OpenAI key (used by query.py CLI, not the dashboard)
# OPENAI_API_KEY=your_openai_key_here

# --- OKF "LLM wiki" / feature-docs enrichment LLM -----------------------------
# Which LLM writes the wiki pages (cvg-okf-build, cvg-docs-build, cvg-ingest --docs,
# and dashboard "regenerate"): deepseek (cloud, default) | omlx (local, offline).
# OKF_LLM_PROVIDER=deepseek

# DeepSeek API key — required when OKF_LLM_PROVIDER=deepseek
# Get your key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_key_here

# Optional: DeepSeek base URL (OpenAI-compatible endpoint; default shown)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Local alternative: an oMLX server on this Mac (https://github.com/jundot/omlx),
# or any OpenAI-compatible local endpoint. Model ids are the folder names under
# ~/.omlx/models — check with: curl -H "Authorization: Bearer $OMLX_API_KEY" $OMLX_BASE_URL/models
# NOTE: keep values on their own line — anything after the value that is not
# preceded by '#' becomes part of the value (e.g. a model id that is "not served").
# OKF_LLM_PROVIDER=omlx
# OMLX_BASE_URL=http://localhost:8000/v1
# The key from oMLX settings (leave empty if the server has verification off):
# OMLX_API_KEY=
# Model id used for both tiers unless OKF_MODEL_FLASH / OKF_MODEL_PRO override it:
# OMLX_MODEL=gemma-4-e2b-it-4bit

# Optional: OKF enrichment model tiers. Defaults: deepseek-v4-flash / deepseek-v4-pro
# for deepseek; OMLX_MODEL for both when OKF_LLM_PROVIDER=omlx.
# OKF_MODEL_FLASH=deepseek-v4-flash
# OKF_MODEL_PRO=deepseek-v4-pro

# Optional: concurrent enrichment requests (default 6 for deepseek, 2 for omlx)
# OKF_CONCURRENCY=2

# Optional: feature-level (business-logic) docs — cvg-docs-build / cvg-ingest --docs
# See docs/okf-wiki.md#feature-docs. Defaults shown.
# CVG_DOCS_LANGUAGE=en
# OKF_FEATURES_MODEL=deepseek-v4-pro
# OKF_MAX_FEATURES=40
# CVG_DOCS_BUNDLE_DIR=okf-wiki
# "lazy" loads the embedding model in the dashboard API process on first
# edit/regenerate (needed to keep Qdrant in sync); "off" skips it and marks
# affected pages needs_reembed=true instead (safer on memory-constrained hosts).
# CVG_API_EMBEDDER=lazy

# Optional: Qdrant configuration
# QDRANT_URL=http://localhost:6333

# Optional: override MCP server Python interpreter path
# CVG_MCP_PYTHON=/path/to/python

# Optional: which Qdrant collection + model the MCP server reads.
# Must match what you indexed (main.py / run_mac_mps_24gb.sh --collection-name / --model).
# The collection is the BASE name; the server appends the model+dim suffix automatically.
# CVG_COLLECTION_NAME=code_chunks
# CVG_MODEL_ID=jina

# --- Dashboard AI chat provider ---------------------------------------------
# CVG_CHAT_PROVIDER selects the LLM behind the dashboard chat: anthropic | openai | deepseek.
# Leave unset to auto-detect: anthropic if ANTHROPIC_API_KEY is set, else deepseek if
# DEEPSEEK_API_KEY is set, else openai.
# CVG_CHAT_PROVIDER=deepseek

# Optional: model override (defaults: ANTHROPIC_MODEL / gpt-4o-mini / deepseek-v4-flash)
# CVG_CHAT_MODEL=deepseek-v4-flash

# Optional: base URL override for OpenAI-compatible endpoints
# (defaults: DEEPSEEK_BASE_URL for deepseek, OPENAI_BASE_URL or the OpenAI default for openai)
# CVG_CHAT_BASE_URL=https://api.deepseek.com

# Optional: API key override; otherwise the selected provider's own key is used
# (ANTHROPIC_API_KEY / OPENAI_API_KEY / DEEPSEEK_API_KEY). Check GET /api/chat/config.
# CVG_CHAT_API_KEY=
